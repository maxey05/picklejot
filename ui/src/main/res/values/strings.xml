    <string name="privacy_summary">Your matches stay on your phone.</string>
    <string name="privacy_point_account">No account or sign-in</string>
    <string name="privacy_point_tracking">No servers, ads or tracking</string>
    <string name="privacy_point_sharing">Nothing is sold or shared</string>
    <string name="privacy_effective">Effective 3 October 2026</string>
    <string name="privacy_stores_heading">What Picklejot stores</string>
    <string name="privacy_stores_body">Your matches, scores, notes, photos, player names, your name and your reminder settings. All of it is saved on this device only. We never receive a copy.</string>
    <string name="privacy_permissions_heading">Permissions</string>
    <string name="privacy_permissions_body">Camera, only when you take a match photo. Notifications, only for the streak reminder you turn on. You can turn either off in system settings.</string>
    <string name="privacy_google_heading">Google services</string>
    <string name="privacy_google_body">Buying Pro goes through Google Play. Google handles the payment, and Picklejot only learns that Pro is unlocked. Android may also back up app data to your Google account. Both follow Google\'s privacy policy.</string>
    <string name="privacy_exports_heading">Exports and sharing</string>
    <string name="privacy_exports_body">Export files and share cards are created only when you ask. Where they go next is up to you.</string>
    <string name="privacy_delete_heading">Deleting your data</string>
    <string name="privacy_delete_body">Use Erase all data in Settings, or uninstall the app. Since we hold no copy, there is nothing left for us to delete.</string>
    <string name="privacy_children_heading">Children</string>
    <string name="privacy_children_body">Picklejot collects no personal data from anyone, including children.</string>
    <string name="privacy_changes_heading">Changes and contact</string>
    <string name="privacy_changes_body">If this policy changes, the new version appears here with a new date. For questions, use the developer contact on Picklejot\'s Google Play listing.</string>
